# 运行环境：development | test | production；生产环境禁止 SQLite
APP_ENV=production
# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
WEB_PORT=80

# 是否允许请求头模拟身份（仅限测试环境显式启用；生产启用将拒绝启动）
ALLOW_HEADER_AUTH=false
# 会话有效期（秒）
SESSION_TTL_SECONDS=28800
# 登录限流：窗口内最大失败次数
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# 数据库（生产环境必须使用 MySQL，DATABASE_URL 由 Compose 根据下列变量拼装）
MYSQL_DATABASE=zhiyun
MYSQL_USER=zhiyun
MYSQL_PASSWORD=replace-with-a-long-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-password

# 连接串中的密码必须按 RFC 3986 做 URL 编码；配置后优先使用 DATABASE_URL
# DATABASE_URL=mysql+pymysql://zhiyun:replace-with-a-long-password@mysql:3306/zhiyun

# 消息队列（Compose 内部使用服务名 rabbitmq）
RABBITMQ_USER=zhiyun
RABBITMQ_PASSWORD=replace-with-a-long-rabbitmq-password
# 密码含特殊字符时必须 URL 编码
RABBITMQ_URL=amqp://zhiyun:replace-with-a-long-rabbitmq-password@rabbitmq:5672/

# 上传目录与单文件上限（字节）
# UPLOAD_DIR=/data/uploads
# MAX_UPLOAD_BYTES=10485760

# 基线回填使用的默认组织 ID（TASK-002 迁移使用）
# DEFAULT_ORG_ID=default

# AI Provider（PD-003）：生产缺失时按 MODEL_NOT_CONFIGURED 显式处理
# MODEL_BASE_URL=https://api.example.com/v1
# MODEL_API_KEY=replace-with-provider-key
# MODEL_CHAT_NAME=
# MODEL_EMBEDDING_NAME=

# 发布版本（build-release.ps1 生成时自动写入）
IMAGE_VERSION=local
API_IMAGE=zhiyun-api
WORKER_IMAGE=zhiyun-worker
WEB_IMAGE=zhiyun-web
