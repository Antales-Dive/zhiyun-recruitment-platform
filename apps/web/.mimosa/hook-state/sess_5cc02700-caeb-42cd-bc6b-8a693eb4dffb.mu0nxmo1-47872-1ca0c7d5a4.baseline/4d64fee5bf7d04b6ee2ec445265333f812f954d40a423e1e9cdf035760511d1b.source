/** 候选人：导入（幂等、去重）与候选人列表/详情。 */
import { useEffect, useState, type FormEvent } from "react";
import { Link } from "react-router-dom";
import { api } from "../../api/client";
import { EmptyState, ErrorState, LoadingState, PageHeader, StatusBadge } from "../../components/states";
import { useTaskEvents } from "../../hooks/useTaskEvents";
import type { JobInfo } from "../jobs/JobsPage";

export interface CandidateInfo {
  id: string;
  job_id: string;
  name: string;
  status: string;
  task_id: string | null;
  match_score: number | null;
  route: string | null;
}

export function CandidatesPage() {
  const [candidates, setCandidates] = useState<CandidateInfo[] | null>(null);
  const [jobs, setJobs] = useState<JobInfo[]>([]);
  const [selectedJob, setSelectedJob] = useState("");
  const [file, setFile] = useState<File | null>(null);
  const [lastTaskId, setLastTaskId] = useState<string | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [message, setMessage] = useState<string | null>(null);
  const taskState = useTaskEvents(lastTaskId);

  async function refresh() {
    try {
      const [nextCandidates, nextJobs] = await Promise.all([
        api<CandidateInfo[]>("/api/v1/candidates"),
        api<JobInfo[]>("/api/v1/jobs"),
      ]);
      setCandidates(nextCandidates);
      setJobs(nextJobs);
      if (!selectedJob && nextJobs[0]) setSelectedJob(nextJobs[0].id);
    } catch (err) {
      setError(err instanceof Error ? err.message : "加载失败");
    }
  }

  useEffect(() => {
    void refresh();
  }, []);

  async function importResume(event: FormEvent) {
    event.preventDefault();
    setMessage(null);
    if (!selectedJob || !file) {
      setMessage("请选择岗位和简历文件");
      return;
    }
    const form = new FormData();
    form.append("job_id", selectedJob);
    form.append("files", file);
    try {
      const data = await api<{ imports: Array<{ candidate_id: string; task_id: string; reused: boolean }> }>(
        "/api/v1/candidates/import",
        { method: "POST", body: form },
      );
      const first = data.imports[0];
      setLastTaskId(first?.task_id ?? null);
      setMessage(first?.reused ? "重复文件：已返回既有导入结果" : "简历已提交解析");
      await refresh();
    } catch (err) {
      setMessage(err instanceof Error ? err.message : "导入失败");
    }
  }

  return (
    <section>
      <PageHeader title="候选人" />
      <form className="card form-grid" onSubmit={importResume} aria-label="导入简历">
        <label>
          目标岗位
          <select value={selectedJob} onChange={(event) => setSelectedJob(event.target.value)}>
            {jobs.map((job) => (
              <option key={job.id} value={job.id}>
                {job.title}
              </option>
            ))}
          </select>
        </label>
        <label>
          简历文件
          <input
            type="file"
            accept=".pdf,.docx,.txt,.png,.jpg,.jpeg"
            onChange={(event) => setFile(event.target.files?.[0] ?? null)}
          />
        </label>
        {message ? <p className="form-note">{message}</p> : null}
        {taskState.snapshot && taskState.snapshot.status !== "SUCCEEDED" ? (
          <p className="form-note">
            解析进度：{taskState.snapshot.progress}%（{taskState.connectionState}）
          </p>
        ) : null}
        <button type="submit" className="button button-primary">
          导入简历
        </button>
      </form>

      {error ? <ErrorState message={error} retry={() => void refresh()} /> : null}
      {!error && candidates === null ? <LoadingState /> : null}
      {candidates && candidates.length === 0 ? (
        <EmptyState title="暂无候选人" hint="导入简历后这里会显示解析与匹配进度。" />
      ) : null}
      {candidates && candidates.length > 0 ? (
        <ul className="list">
          {candidates.map((candidate) => (
            <li className="card list-item" key={candidate.id}>
              <Link to={`/candidates/${candidate.id}`}>{candidate.name}</Link>
              <StatusBadge status={candidate.status} />
              {candidate.match_score !== null ? <span className="muted">匹配分 {candidate.match_score}</span> : null}
            </li>
          ))}
        </ul>
      ) : null}
    </section>
  );
}
