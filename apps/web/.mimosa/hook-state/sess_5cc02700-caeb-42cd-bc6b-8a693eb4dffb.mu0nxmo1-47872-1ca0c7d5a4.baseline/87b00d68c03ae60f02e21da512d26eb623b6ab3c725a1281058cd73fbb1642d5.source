/** 候选人详情：简历版本、档案与匹配结果。 */
import { useEffect, useState } from "react";
import { useParams } from "react-router-dom";
import { api } from "../../api/client";
import { ErrorState, LoadingState, PageHeader, StatusBadge } from "../../components/states";

interface CandidateDetail {
  candidate_id: string;
  job_id: string;
  name: string;
  status: string;
  resume_versions: Array<{ resume_version_id: string; version_no: number; status: string; quality: unknown }>;
}

export function CandidateDetailPage() {
  const { candidateId } = useParams<{ candidateId: string }>();
  const [detail, setDetail] = useState<CandidateDetail | null>(null);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    api<CandidateDetail>(`/api/v1/candidates/${candidateId}`)
      .then(setDetail)
      .catch((err) => setError(err instanceof Error ? err.message : "加载失败"));
  }, [candidateId]);

  if (error) return <ErrorState message={error} />;
  if (!detail) return <LoadingState />;

  return (
    <section>
      <PageHeader title={detail.name} />
      <StatusBadge status={detail.status} />
      <h2>简历版本</h2>
      {detail.resume_versions.length === 0 ? (
        <p className="muted">暂无简历版本</p>
      ) : (
        <ul className="list">
          {detail.resume_versions.map((version) => (
            <li className="card list-item" key={version.resume_version_id}>
              <span>版本 {version.version_no}</span>
              <StatusBadge status={version.status} />
            </li>
          ))}
        </ul>
      )}
    </section>
  );
}
