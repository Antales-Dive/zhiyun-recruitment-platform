/** 审计：只读审计记录（游标分页）。 */
import { useEffect, useState } from "react";
import { api } from "../../api/client";
import { EmptyState, ErrorState, LoadingState, PageHeader } from "../../components/states";

interface AuditItem {
  id: string;
  action: string;
  resource_type: string;
  resource_id: string | null;
  actor_id: string | null;
  reason: string | null;
  created_at: string;
}

interface AuditPageData {
  items: AuditItem[];
  next_cursor: string | null;
}

export function AuditPage() {
  const [page, setPage] = useState<AuditPageData | null>(null);
  const [error, setError] = useState<string | null>(null);

  async function load(cursor?: string) {
    try {
      const suffix = cursor ? `?cursor=${encodeURIComponent(cursor)}` : "";
      setPage(await api<AuditPageData>(`/api/v1/audit${suffix}`));
    } catch (err) {
      setError(err instanceof Error ? err.message : "加载失败");
    }
  }

  useEffect(() => {
    void load();
  }, []);

  return (
    <section>
      <PageHeader title="审计日志" />
      {error ? <ErrorState message={error} retry={() => void load()} /> : null}
      {page === null && !error ? <LoadingState /> : null}
      {page && page.items.length === 0 ? <EmptyState title="暂无审计记录" /> : null}
      {page && page.items.length > 0 ? (
        <>
          <table className="table">
            <thead>
              <tr>
                <th>时间</th>
                <th>动作</th>
                <th>资源</th>
                <th>操作者</th>
                <th>原因</th>
              </tr>
            </thead>
            <tbody>
              {page.items.map((item) => (
                <tr key={item.id}>
                  <td>{new Date(item.created_at).toLocaleString()}</td>
                  <td>
                    <code>{item.action}</code>
                  </td>
                  <td>
                    {item.resource_type}
                    {item.resource_id ? `:${item.resource_id.slice(0, 8)}` : ""}
                  </td>
                  <td>{item.actor_id?.slice(0, 8) ?? "system"}</td>
                  <td>{item.reason ?? ""}</td>
                </tr>
              ))}
            </tbody>
          </table>
          {page.next_cursor ? (
            <button type="button" className="button" onClick={() => void load(page.next_cursor!)}>
              下一页
            </button>
          ) : null}
        </>
      ) : null}
    </section>
  );
}
